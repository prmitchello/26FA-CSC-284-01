{"text":"#include <iostream>\n#include <string>\n#include \"Student.cpp\"\n#include <vector>\n#include <format>\n\nusing namespace std;\n\nstatic int busCount = 0, engCount = 0, crimCount = 0,\n           medCount = 0, mathCount = 0, humCount = 0, othersCount = 0;\n\nvector<Student> studentList{};\n\nvoid displayAllStudents(vector<Student> &studentList)\n{\n    if (studentList.size() == 0)\n    {\n        cout << \"There are currently no students to print\" << endl;\n    }\n    else\n    {\n\n        for (int i = 0; i < studentList.size(); i++)\n            Student::printStudent(studentList[i]);\n    }\n}\nStudent searchByFullName(vector<Student> &studentList, string fullName)\n{\n\n    Student noStudentFlag{-1, \"N/A\", -1, \"N/A\", \"N/A\"};\n    for (int i = 0; i < studentList.size(); i++)\n    {\n\n        if (studentList[i].getName() == fullName)\n        {\n            return studentList[i];\n        }\n    }\n    std::cout << endl\n              << \"Student not found in the registery \\n\"\n              << endl;\n\n    return noStudentFlag;\n}\nStudent searchByID(vector<Student> &studentList, int IDSearch)\n{\n\n    Student noStudentFlag{-1, \"N/A\", -1, \"N/A\", \"N/A\"};\n    for (int i = 0; i < studentList.size(); i++)\n    {\n\n        if (studentList[i].getID() == IDSearch)\n        {\n            return studentList[i];\n        }\n    }\n\n    std::cout << endl\n              << \"Student not found in the registery \\n\"\n              << endl;\n\n    return noStudentFlag;\n}\nvoid headerTemplate()\n{\n    std::cout << \"ID \" << std::setw(10) << \"Name\" << std::setw(20) << \"Age\" << std::setw(10) << \"Major\" << std::setw(20) << \"Email\" << std::endl;\n    std::cout << \" ---------------------------------------------------------------------\" << std::endl;\n}\nstring chooseMajor(char charInput)\n{\n\n    string Bus = \"Business\", Eng = \"Eng\", Crim = \"criminal Justice\",\n           Med = \"Medice\", Math = \"Math\", Hum = \"Humanitites\", others = \"Others\";\n\n    switch (charInput)\n    {\n\n    case 'a':\n    {\n\n        busCount++;\n\n        return Bus;\n\n        break;\n    }\n    case 'b':\n    {\n\n        engCount++;\n\n        return Eng;\n\n        break;\n    }\n    case 'c':\n    {\n\n        crimCount++;\n        return Crim;\n\n        break;\n    }\n    case 'd':\n    {\n\n        medCount++;\n        return Med;\n\n        break;\n    }\n    case 'e':\n    {\n\n        mathCount++;\n        return Math;\n\n        break;\n    }\n\n    case 'f':\n    {\n\n        humCount++;\n        return Hum;\n\n        break;\n    }\n    case 'g':\n    {\n\n        othersCount++;\n        return others;\n\n        break;\n    }\n    default:\n    {\n\n        cout << \"invalid character entered\" << endl;\n    }\n    }\n    string nf = \"not found\";\n    return nf;\n}\n\nvoid displayNumStudentsbyMajor()\n{\n\n    cout << endl\n         << format(\"the number of students in each major. Math: {}  Engineering: {}  Medicine:  {}  Humanities: {} Criminal Justice: {}   Others: {} \",\n                   mathCount, engCount, medCount, humCount, crimCount, othersCount)\n         << endl;\n}\n\nvoid validateName(string &nameInput)\n{\n\n    size_t startOfString = nameInput.find_first_of(\" \\t\");\n    size_t endOfString = nameInput.find_last_not_of(\" \\t\");\n\n    if (startOfString != string::npos)\n    {\n\n        nameInput = nameInput.substr(startOfString - endOfString + 1);\n    }\n    else\n    {\n        nameInput = \" \";\n    }\n}\n","version":1,"path":"studentMethods.cpp","snapshot":true,"doc":1,"seq":2,"ms":-1379,"op":"snap"}
{"text":"/*\n\nassignment 1,\nMitchello Pierre Rene\n\nthis program keeps a record of students. User are responsible for inputing thngs like name, int and major.\nFor is store in a vectorList. The user interacts with a menu based do while loop to choose different options.\nLike adding students, printing students, and search operations like by name and id number.\n\n*/\n\n#include <iostream>\n#include <string>\n#include <cctype>\n#include <algorithm>\n#include \"studentMethods.cpp\"\n\n// using namespace std;\n\nint main()\n{\n\n    string menuInput;\n    int choice;\n    int idUpperLimit = 999999, idLowerLimit = 100000;\n    int ageUpperLimit = 65, ageLowerLimit = 18;\n\n    bool Quit = false;\n\n    do\n    {\n        std::cout << endl\n                  << \"to add student enter 1: \" << endl\n                  << \"to search by full name enter 2: \" << endl\n                  << \"to search by id enter 3: \" << endl\n                  << \"to print all students enter 4: \" << endl\n                  << \"to print number of students in each major enter 5: \" << endl\n                  << \"to quit enter Q: \" << endl\n                  << endl\n                  << \"input: \";\n\n        std::cin >> menuInput;\n        std::cin.ignore();\n        cout << endl;\n\n        if (toupper(menuInput[0]) == 'Q')\n        {\n            Quit = true;\n            cout << \"exiting the program, thank you!\";\n            continue;\n        };\n\n        // this will catch case where letters are entered in the string\n        try\n        {\n\n            choice = stoi(menuInput);\n        }\n        catch (const std::invalid_argument &e)\n        {\n            cout << \"You entered character, input expecting integer\" << endl;\n            continue;\n        };\n\n        switch (choice)\n        {\n\n        case 1:\n        {\n            Student user{};\n\n            string User_nameInput;\n            std::cout << \"please enter Student full name \";\n\n            std::getline(std::cin, User_nameInput);\n            user.setName(User_nameInput);\n\n            int User_ageInput;\n            std::cout << \"please enter student age(18+) \";\n            std::cin >> User_ageInput;\n\n            if (User_ageInput > ageUpperLimit || User_ageInput < ageLowerLimit)\n            {\n\n                cout << endl\n                     << \"invalid age!\" << endl;\n                continue;\n            }\n            user.setAge(User_ageInput);\n\n            int User_idInput;\n            std::cout << \"Please enter student ID(6 digits) \";\n            std::cin >> User_idInput;\n\n            if (User_idInput > idUpperLimit || User_idInput < idLowerLimit)\n            {\n\n                cout << endl\n                     << \"invalid ID!\" << endl;\n                continue;\n            }\n\n            user.setID(User_idInput);\n\n            // dont ask for major, give a choice\n            char User_majorInput;\n            std::cout << \"Please select the student's major \" << \"a : Business, b: Eng, C: criminal Justice, d: medice, e: Math, f: Hum, g: others \" << endl;\n\n            cin >> User_majorInput;\n\n            string majorResult = chooseMajor(User_majorInput);\n\n            if (majorResult == \"not found\")\n            {\n                continue;\n            }\n\n            user.setMajor(majorResult);\n\n            // use student name with email extension\n            string emailExtension = \"@uni.edu\";\n\n            // checks from beginning to end of strign for white space and removes\n            user.getName().erase(remove_if(user.getName().begin(), user.getName().end(), ::isspace), user.getName().end());\n\n            user.setEmail(user.getName() + emailExtension);\n\n            studentList.push_back(user);\n\n            break;\n        }\n\n        case 2:\n        {\n            string nameSearch;\n            cout << \"please enter the name to search: \";\n            cin >> nameSearch;\n            cin.ignore();\n            cout << endl;\n\n            Student searchResult = searchByFullName(studentList, nameSearch);\n\n            headerTemplate();\n            Student::printStudent(searchResult);\n            std::cout << endl;\n\n            break;\n        }\n        case 3:\n        {\n\n            int idSearch;\n            cout << \"please enter the ID to search: \";\n            cin >> idSearch;\n            cout << endl;\n\n            Student searchResult = searchByID(studentList, idSearch);\n\n            headerTemplate();\n            Student::printStudent(searchResult);\n            std::cout << endl;\n\n            break;\n        }\n        case 4:\n        {\n            headerTemplate();\n            displayAllStudents(studentList);\n            break;\n        }\n\n        case 5:\n        {\n            displayNumStudentsbyMajor();\n            break;\n        }\n        default:\n        {\n\n            cout << \"a valid menu choice was not entered\" << endl;\n\n            break;\n        }\n        }\n    } while (!Quit);\n\n    return 0;\n}\n","version":1,"path":"studentRecord.cpp","snapshot":true,"doc":2,"seq":3,"ms":12147,"op":"snap"}
