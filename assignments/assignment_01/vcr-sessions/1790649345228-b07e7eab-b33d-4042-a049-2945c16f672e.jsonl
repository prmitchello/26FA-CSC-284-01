{"text":"#include <iostream>\n#include <string>\n#include \"Student.cpp\"\n#include <vector>\n\nusing namespace std;\n\nStudent searchByFullName(vector<Student> &studentList, string fullName);\n\nint main()\n{\n\n    vector<Student> studentList{};\n\n    Student bob{};\n\n    int User_idInput;\n    cout << \"Please enter student ID\";\n    cin >> User_idInput;\n    bob.setID(User_idInput);\n\n    string User_nameInput;\n    cout << \"please enter Student full name\";\n    cin >> User_nameInput;\n    bob.setName(User_nameInput);\n\n    int User_ageInput;\n    cout << \"please enter student age\";\n    cin >> User_ageInput;\n    bob.setAge(User_ageInput);\n\n    string User_majorInput;\n    cout << \"Please enter student's major\";\n    cin >> User_majorInput;\n    bob.setMajor(User_majorInput);\n\n    string User_emailInput;\n    cout << \"Please enter the student's email\";\n    cin >> User_emailInput;\n    bob.setEmail(User_emailInput);\n    cin.ignore();\n\n    studentList.push_back(bob);\n\n    Student example = searchByFullName(studentList, \"bob\");\n\n    cout << \"stuednt name is \" << example.getName();\n    cout << \"stuednt name is \" << example.getID() << endl;\n    cout << \"stuednt email is \" << example.getEmail();\n    cout << \"stuednt major is \" << example.getMajor() << endl;\n    cout << \"stuednt age is \" << example.getAge();\n\n    return 0;\n}\n\n/*void displayAllStudents(vector<Student>&studentList){\n\n    for(int i=0; i< studentList.size(); i++)\n    cout<<studentList[i]<<;\n}*/\nStudent searchByFullName(vector<Student> &studentList, string fullName)\n{\n\n    Student eturnVoidFlag{123, \"void\", 21, \"N/A\", \"N/A\"};\n    for (int i = 0; i < studentList.size(); i++)\n    {\n\n        if (studentList[i].getName() == fullName)\n        {\n            return studentList[i];\n        }\n        else\n        {\n            cout << \"Student not found in the registery\";\n        }\n    }\n\n    return eturnVoidFlag;\n}\n","version":1,"path":"studentRecord.cpp","snapshot":true,"doc":1,"seq":2,"ms":-729,"op":"snap"}
