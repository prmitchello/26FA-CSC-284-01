{"text":"#include <string>\nusing namespace std;\n\nclass Student{\n\n\n    private:\n\n    int id;\n    string name;\n    int age;\n    string major;\n    string email;\n\n\n\n\n    public:\n\n    Student(){\n\n    }\n    Student(int id, string name, int age, string major, string email){\n\n        id=id;\n        name=name;\n        age=age;\n        major=major;\n        email=email;\n\n    }\n\n    void setID(int ID){\n        id=ID;\n    }\n    int getID(){\n        return id;\n    }\n\n    void setName(string name){\n        name=name;\n    }\n    string getName(){\n        return name;\n    }\n\n    void setAge(int age){\n        age=age;\n    }\n    int getAge(){\n        return age;\n    }\n\n    void setMajor(string major){\n        major=major;\n    }\n    string getMajor(){\n        return major;\n    }\n\n    void setEmail(string email){\n        email=email;\n    }\n    string getEmail(){\n        return email;\n    }\n\n\n\n};\n","version":1,"path":"Student.cpp","snapshot":true,"doc":3,"seq":92,"ms":1116569,"op":"snap"}
