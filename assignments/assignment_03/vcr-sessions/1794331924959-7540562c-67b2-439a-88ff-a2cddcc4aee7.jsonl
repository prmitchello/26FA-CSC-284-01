{"text":"#pragma once\n#include <string>\n#include <vector>\n\nusing namespace std;\n\nclass Book{\n\n    private:\n    std::string title;\n    std::string author;\n    int year;\n    std::string genre;\n\n\n    public:\n\n    Book(std::string t, std::string a , int y, std::string g){\n        title = t;\n        author = a;\n        year = y;\n        genre = g;\n    }\n    string getTitle(){\n        return title;\n    }\n    string getAuthor(){\n        return author;\n    }\n    string getGenre(){\n        return genre;\n    }\n    int getYear(){\n        return year;\n    }\n    void setTitle(string title){\n        this->title=title;\n    }\n    void setAuthor(string author){\n        this->author = author;\n    }\n    void setYear(int year){\n        this->year=year;\n    }\n    void setGenre(string genre){\n        this->genre = genre;\n    }\n\n    std::string toString ()\n    {\n\n        return \"book\" + title;\n    }\n\n\n\n};\n","version":1,"path":"Book.h","snapshot":true,"doc":4,"seq":137,"ms":1017255,"op":"snap"}
