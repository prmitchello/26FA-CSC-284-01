{"text":"#pragma once\n#include <iostream>\n#include <string>\n#include <vector>\n#include <iomanip>\n#include <ranges>\n#include <algorithm>\n#include \"Book.h\"\n\n//ifnotdef\n//define\n//endif;\n\nusing namespace std;\n\ntemplate <typename T=string>\nclass Library {\n\n    public:\n\n    std::vector<Book> bookCollections{};\n\n    Library(){\n        std::vector<Book> bookCollections{};\n    }\n\n    //: Adds a new book to the library.\n    void add_book(const Book& book){\n\n        bookCollections.push_back(book);\n    }\n    //: Removes a book from the library based on its title.\n    T remove_book(const std::string& title){\n        //needs to first find the matching book before removing\n        bookCollections.pop_back();\n    }\n    //: Searches for a book by title and returns it (if found) or prints an error message.\n    T find_book(const std::string& title){\n        \n        auto byTitle = bookCollections\n        | std::views::filter([&](string n)->string{ if(n == title)return n ;});\n        ranges::for_each(byTitle, ([](string n)->string{return n;}));\n\n        //std::range::;\n    }\n    //: Returns a collection of books written by the specified author.\n    T get_books_by_author(const std::string& author){\n\n        auto byAuthor = bookCollections\n        | std::views::filter([&](string n)->string{ if(n == author)return n;});\n        ranges::for_each(byAuthor, ([](string n)->string{return n;}));\n        //std::range::\n    }\n    //: Returns a collection of books belonging to the specified genre.\n    T get_books_by_genre(const std::string& genre){\n\n        auto byGenre = bookCollections\n        | std::views::filter([&](string n)->string{ if(n == genre)return n;});\n        ranges::for_each(byGenre, ([](string n)->string{return n;}));\n\n        // std::range::;\n        // find()\n    }\n\n    void printBooks(){\n        cout<<\"The books currently in the library: \\n\"<<endl;\n        for(vector<Book>::iterator it = bookCollections.begin(); it<bookCollections.end(); ++it){\n\n            //cout<<*it;\n            //it.title;\n            //bookCollections;\n            std::cout<<\"Title: \"<<it->getTitle()<<setw(35)<<\" Author: \"<<it->getAuthor()<<setw(10)<<endl;\n\n        }\n    }\n\n    // Use a std::vector<Book>::iterator to traverse the books in the library.\n    // Use an iterator to display all books in the library.\n    // Implement an iterator-based search function that finds books by author.\n\n\n};\n\n","version":1,"path":"Library.h","snapshot":true,"doc":1,"seq":2,"ms":-2689,"op":"snap"}
{"text":"#include <iostream>\n#include \"Library.h\"\n\n\n\n\nusing namespace std;\n\n\nint main(){\n\n\n    Library bhccLibrary{};\n\n    Book b1(\"game of thrones\",\"GRR Martin\",1988,\"Fiction\");\n    Book b2(\"The things you carry\",\"GRR Martin\",1988,\"Fiction\");\n    Book b3(\"The giver\",\"GRR Martin\",1988,\"Fiction\");\n    Book b4(\"Outsiders\",\"SE Hilton\",1988,\"Fiction\");\n    Book b5(\"Elden Rings\",\"GRR Martin\",1988,\"Fiction\");\n    Book b6(\"House of the dragon\",\"GRR Martin\",1988,\"Fiction\");\n\n    bhccLibrary.add_book(b1);\n    bhccLibrary.add_book(b2);\n    bhccLibrary.add_book(b3);\n    bhccLibrary.add_book(b4);\n    bhccLibrary.add_book(b5);\n    bhccLibrary.add_book(b6);\n\n    bhccLibrary.printBooks();\n\n    bhccLibrary.remove_book(b1.getTitle());\n\n    cout<<endl;\n    bhccLibrary.printBooks();\n\n\n\n//     Demonstrate the use of common Standard Library container algorithms and operations.\n\n// Your program should:\n\n// Add books to the library.\n// Remove books using erase() and remove_if().\n// Sort books by publication year in:\n// Ascending order\n// Descending order\n// Use std::find_if() to locate a book by title.\n\n\n    return 0;\n}\n","version":1,"path":"main.cpp","snapshot":true,"doc":2,"seq":3,"ms":269554,"op":"snap"}
