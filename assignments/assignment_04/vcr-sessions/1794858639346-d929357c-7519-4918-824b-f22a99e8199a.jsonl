{"text":"#include \"LogAnalyzer.h\"\n#include <fstream>\n#include <iostream>\n#include <thread>\n#include <algorithm>\n#include <ranges>\n#include <vector>\n#include <string>\n\nusing namespace std;\n\nvoid LogAnalyzer::analyzeFile(const std::string& filename, const std::vector<string>& keywords) {\n\n\n    std::ifstream file(filename);\n\n    if (!file) {\n        std::cerr << \"Error: Could not open file \" << filename << \"\\n\";\n        return;\n    }\n    std::cout << \"Processing: \" << filename << std::endl;\n\n    std::string line;\n\n    int count=0;\n\n    while(getline(file,line)){\n\n\n        cout<<line;\n        int keyCount=0;\n\n\n        for(string key : keywords){\n\n            count++;\n\n            std::cout<<count;\n\n            if(line.find(key) != string::npos){\n\n\n                cout<<\"found\"<<line<<endl;\n\n                lock_guard<mutex> lock(countMutex);\n\n                keywordCounts[key]++;\n\n                // keywordCounts.insert( {\"line\",keyCount});\n\n            }\n        }\n\n\n    }\n    file.close();\n\n    // TODO: Read each line.\n    // For each keyword in 'keywords', check if it exists in the line.\n    // If found, increment keywordCounts[keyword] (inside a mutex lock).\n}\n\nvoid LogAnalyzer::printSummary() const {\n    std::cout << \"\\n--- Keyword Summary ---\\n\";\n\n    lock_guard<mutex> lock(countMutex);\n\n    for_each(keywordCounts.begin(),keywordCounts.end(),[](auto &data){\n        cout<<data.first << \": \"<<data.second<<endl;\n    } );\n\n\n\n    // TODO: Use std::for_each and a lambda to print keyword counts.\n\n    std::cout << \"-----------------------\\n\";\n}\n","version":1,"path":"LogAnalyzer.cpp","snapshot":true,"doc":3,"seq":144,"ms":773345,"op":"snap"}
