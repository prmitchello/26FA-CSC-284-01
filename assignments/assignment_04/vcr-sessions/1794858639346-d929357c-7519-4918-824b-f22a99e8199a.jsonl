{"text":"#include \"LogAnalyzer.h\"\n#include <iostream>\n#include <filesystem>\n#include <thread>\n#include <vector>\n\nnamespace fs = std::filesystem;\n\nint main(int argc, char* argv[]) {\n\n    if (argc < 2) {\n        std::cerr << \"Usage: \" << argv[0] << \" <log_directory>\\n\";\n        return 1;\n    }\n\n    std::string folderPath = argv[1];\n    LogAnalyzer analyzer;\n\n        std::vector<std::string> keywords = {\"[ERROR]\", \"[WARNING]\", \"[INFO]\", \"[FATAL]\", \"[DEBUG]\", \"TRACE]\"};   // /* TODO: Add the rest of the error levels */};\n        std::vector<std::thread> threads;\n\n    std::cout << \"Analyzing folder: \" << folderPath << \"\\n\\n\";\n\n    // TODO: Use std::filesystem to iterate through all files in the folder.\n    // For each file with \".log\" extension:\n    //   - Create a thread calling analyzer.analyzeFile(filename, keywords)\n    //   - Store the thread in 'threads' vector.\n\n\n    // std::filesystem(for_each(){\n\n\n    for(auto& data : fs::directory_iterator(folderPath)){\n\n        if(folderPath.is_regularDirectory && data.path().extension()==\".log\"){\n\n        }\n\n     threads.emplace_back(LogAnalyzer::analyzeFile,folderPath, keywords);\n\n        // threads.push_back(t1);\n\n    }\n    // TODO: Join all threads after launching.\n\n    std::cout<<\" we are here\"<<std::endl;\n    analyzer.analyzeFile(folderPath, keywords);\n    analyzer.printSummary();\n\n    return 0;\n}\n","version":1,"path":"main.cpp","snapshot":true,"doc":1,"seq":2,"ms":-3487,"op":"snap"}
