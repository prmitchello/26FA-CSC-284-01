{"text":"/*\n    Mitchello Pierre-Rene\n    11/22/26\n    CSC 284-01\n    header comment\n*/\n\n#include <iostream>\n#include <string>\n#include <ncurses.h>\n\n#include \"Windows.cpp\"\n#include \"RoomList.cpp\"\n#include \"MessageArea.cpp\"\n#include \"FriendsWindow.cpp\"\n\n\nusing namespace std;\n\n\nint main(){\n\n    //initialize the screen\n    initscr();\n\n    Windows ui;\n    ui.initialize();\n\n    RoomList topics;\n    topics.drawLeft(ui.getTopicsWindow());\n\n    MessageArea generalChat;\n    MessageArea sportChat;\n    MessageArea musicChat;\n\n    MessageArea* activeChat=&generalChat;\n\n    FriendsWindow friends;\n    friends.drawWindow(ui.getFriendsWindow());\n\n\n    string input=\"\";\n\n\n    //allow keyboard input in the bottom window\n    keypad(ui.getChatWindow(),true);\n\n    while (true){\n\n        //we then read the keyboard inputs to do operation with\n        int typingInput = wgetch(ui.getChatWindow());\n\n        switch(typingInput){\n\n            case KEY_UP:{\n\n                topics.selectUp();\n\n                switch(topics.getHighlight()){\n                    case 0:{\n                        br\n                    }\n\n                }\n\n                    sportChat.textInput(\"You: \"+input);\n                    //chat.push_back(\"You: \"+input);\n                    sportChat.drawChat(ui.getMainWindow());\n\n                topics.drawLeft(ui.getTopicsWindow());\n\n                break;\n            }\n            case KEY_DOWN:{\n\n                topics.selectDown();\n                topics.drawLeft(ui.getTopicsWindow());\n\n                break;\n            }\n            // case KEY_LEFT:{\n            //     highlight=(highlight == 0)? sideMenu.size() -1: highlight-1;\n            //     break;\n            // }\n            // case KEY_RIGHT:{\n            //     highlight=(highlight == sideMenu.size()-1)? 0: highlight+1;\n            //     break;\n            // }\n            case KEY_ENTER:\n            case '\\n':{\n\n                if(!input.empty()){\n\n                    generalChat.textInput(\"You: \"+input);\n                    //chat.push_back(\"You: \"+input);\n                    generalChat.drawChat(ui.getMainWindow());\n\n                }\n\n                input.clear();\n\n                wclrtoeol(ui.getChatWindow());\n\n                mvwprintw(ui.getChatWindow(),1,1,\"input > \");\n\n                wrefresh(ui.getChatWindow());\n\n                break;\n            }\n            case KEY_BACKSPACE:\n            case 127:\n            case '\\b': {\n\n                if(!input.empty()){\n                    input.pop_back();\n                }\n\n                wclrtoeol(ui.getChatWindow());\n                wmove(ui.getChatWindow(),1,2);\n\n                mvwprintw(ui.getChatWindow(),1,1,\"input > %s\", input.c_str());\n                wrefresh(ui.getChatWindow());\n\n                break;\n            }\n\n        }\n\n        if(typingInput >=32 && typingInput <= 126){\n\n            //cast everything to char to stop display arrow up and down input\n            input+=static_cast<char>(typingInput);\n\n            wrefresh(ui.getChatWindow());\n\n            wclrtoeol(ui.getChatWindow());\n\n            wmove(ui.getChatWindow(),1,1);\n\n            mvwprintw(ui.getChatWindow(),1,1,\"input > %s\",input.c_str());\n\n            wrefresh(ui.getChatWindow());\n\n\n        }\n    }\n\n    endwin();\n\n    return 0;\n\n}\n","version":101,"snapshot":true,"doc":1,"seq":169,"ms":11844627,"op":"edit"}
