{"text":"#include <vector>\n#include <string>\n#include<curses.h>\n\nusing namespace std;\n\nclass RoomList {\n\n    private:\n\n        vector<string> topicList;\n        int highlight;\n\n    public:\n\n        RoomList(){\n            topicList ={\"General\", \"Sports\",\"Programming\",\"Music\",\"Random\"};\n            int highlight = 0;\n        }\n\n        void selectUp(){\n            highlight=(highlight == 0)? topicList.size() -1: highlight-1;\n        }\n\n        void selectDown(){\n            highlight=(highlight == topicList.size()-1)? 0: highlight+1;\n\n        }\n\n        void drawLeft(WINDOW* leftInner){\n            int length = topicList.size();\n\n            for(int i=0; i<length ; ++i){\n\n                if(i == highlight){\n                    //start_color();\n                    attron(A_REVERSE);\n                        mvwprintw(leftInner, (i+3) ,1,\"> %s\",topicList[i].c_str());\n                    attroff(A_REVERSE);\n\n                }else{\n                    mvwprintw(leftInner, (i+3) ,1,topicList[i].c_str());\n                }\n\n            }\n\n            wrefresh(leftInner);\n\n        }\n\n};\n","version":1,"path":"RoomList.cpp","snapshot":true,"doc":2,"seq":97,"ms":11781634,"op":"snap"}
