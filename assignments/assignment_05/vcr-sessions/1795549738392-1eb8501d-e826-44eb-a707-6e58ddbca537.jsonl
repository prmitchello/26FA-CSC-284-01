{"text":"#include<curses.h>\n\nclass Windows {\n\n    private:\n\n        WINDOW* mainWin;\n        WINDOW* mainInner;\n\n        WINDOW* bottomWin;\n        WINDOW* bottomInner;\n\n        WINDOW* leftWin;\n        WINDOW* leftInenr;\n\n        WINDOW* rightWin;\n        WINDOW* rightInner;\n        \npublic:\n        //default constructor to initialize\n        Windows(){\n\n            WINDOW* mainWin=nullptr;\n            WINDOW* mainInner=nullptr;\n\n            WINDOW* bottomWin=nullptr;\n            WINDOW* bottomInner=nullptr;\n\n            WINDOW* leftWin=nullptr;\n            WINDOW* leftInenr=nullptr;\n\n            WINDOW* rightWin=nullptr;\n            WINDOW* rightInner=nullptr;\n\n        }\n\n\n        void initialize(){\n\n            //box values to allign the screen\n            int terminalWidth=COLS;\n            int terminalLength=LINES;\n\n            int sidePanelWidth =20;\n            int sidePanelLength = terminalLength -1;\n\n            int y_startAt_0 = 0;\n            int x_startAt_0 = 0;\n\n\n            WINDOW* mainWin = newwin((sidePanelLength -10) ,(terminalWidth-40),y_startAt_0,(x_startAt_0 + 20));\n            WINDOW* mainInner = newwin((sidePanelLength -13) ,(terminalWidth-42),y_startAt_0+2,(x_startAt_0 + 21));\n\n            WINDOW* bottomWin = newwin( 10 ,(terminalWidth-40),(terminalLength - 11) , (x_startAt_0 + 20) );\n            WINDOW* bottomInner = newwin( 5 ,(terminalWidth-44),(terminalLength - 8) , (x_startAt_0 + 22) );\n\n            WINDOW* rightWin = newwin(sidePanelLength,sidePanelWidth,y_startAt_0,(terminalWidth-20));\n            WINDOW* rightInner = newwin(sidePanelLength-3,sidePanelWidth-4,y_startAt_0+2,(terminalWidth-18));\n\n            WINDOW* leftWin = newwin(sidePanelLength,sidePanelWidth,y_startAt_0,x_startAt_0);\n            WINDOW* leftInner = newwin(sidePanelLength-3,sidePanelWidth-4,y_startAt_0+2,x_startAt_0+2);\n\n            mvwprintw(rightWin,1,6,\"Friends\");\n            mvwprintw(leftWin,1,8,\"Feed\");\n            mvwprintw(bottomInner,1,1,\"Type > \");\n            mvwprintw(mainWin,1,40,\"Advanced C++ Chat Client\");\n\n            // box creates a border for each win and gives them a visible effect\n            box(mainWin,0,0);\n            box(mainInner,0,0);\n            box(bottomWin,0,0);\n            box(bottomInner,0,0);\n            box(leftWin,0,0);\n            box(leftInner,0,0);\n            box(rightWin,0,0);\n            box(rightInner,0,0);\n\n\n            wrefresh(mainWin);\n            wrefresh(mainInner);\n            wrefresh(bottomWin);\n            wrefresh(bottomInner);\n            wrefresh(rightWin);\n            wrefresh(rightInner);\n            wrefresh(leftWin);\n            wrefresh(leftInner);\n\n        }\n\n    public:\n\n        WINDOW* getTopicsWindow(){\n            return leftInenr;\n        }\n        WINDOW* getMainWindow(){\n            return leftInenr;\n        }\n        WINDOW* getChatWindow(){\n            return leftInenr;\n        }\n        WINDOW* getFriendsWindow(){\n            return leftInenr;\n        }\n\n};\n","version":1,"path":"Windows.cpp","snapshot":true,"doc":3,"seq":290,"ms":12204173,"op":"snap"}
