{"text":"#include <ncurses.h>\n\nclass FriendsWindow{\n\n    private:\n\n    // initscr();\n\n    // //box values to allign the screen\n    // int terminalWidth=COLS;\n    // int terminalLength=LINES;\n\n    // int sidePanelWidth =20;\n    // int sidePanelLength = terminalLength -1;\n\n    // int y_startAt_0 = 0;\n\n\n    // //creating new windows to hold different places on the screen\n\n\n    // WINDOW* rightWin = newwin(sidePanelLength,sidePanelWidth,y_startAt_0,(terminalWidth-20));\n    // WINDOW* rightInner = newwin(sidePanelLength-3,sidePanelWidth-4,y_startAt_0+2,(terminalWidth-18));\n\n    // mvwprintw(rightWin,1,6,\"Friends\");\n\n\n    // box(rightWin,0,0);\n    // box(rightInner,0,0);\n\n\n    // wrefresh(rightWin);\n    // wrefresh(rightInner);\n\n\n    public:\n\n    void drawWindow(){\n\n    }\n\n    void getWindow(){\n\n    }\n\n    void setWindow(){\n\n    }\n    void navigate(){\n\n    }\n\n\n\n\n\n\n\n\n\n\n\n};\n","version":1,"path":"friendsWindow.cpp","snapshot":true,"doc":4,"seq":8,"ms":39627,"op":"snap"}
{"text":"/*\n    Mitchello Pierre-Rene\n    11/22/26\n    CSC 284-01\n    header comment\n*/\n\n#include <iostream>\n#include <vector>\n#include <string>\n#include <ncurses.h>\n//#include <curses.h>\n\nusing namespace std;\n\nvoid drawLeft(WINDOW* ,vector<string>&  , int );\nvoid drawChat(WINDOW* ,vector<string>&);\n\nint main(){\n\n    //initialize the screen\n    initscr();\n\n    \n    vector <string> chat;\n\n    int highlight = 0;\n\n\n    drawLeft(leftInner, sideMenu, highlight);\n\n\n\n    vector<string> text;\n\n    string type=\"\";\n\n\n    //allow keyboard input in the bottom window\n    keypad(bottomInner,true);\n\n    while (true){\n\n        //we then read the keyboard inputs to do operation with\n        int typingInput = wgetch(bottomInner);\n\n        switch(typingInput){\n            case KEY_UP:{\n                highlight=(highlight == 0)? sideMenu.size() -1: highlight-1;\n                    drawLeft(leftInner,sideMenu,highlight);\n                break;\n            }\n            case KEY_DOWN:{\n                highlight=(highlight == sideMenu.size()-1)? 0: highlight+1;\n                    drawLeft(leftInner,sideMenu,highlight);\n                break;\n            }\n            // case KEY_LEFT:{\n            //     highlight=(highlight == 0)? sideMenu.size() -1: highlight-1;\n            //     break;\n            // }\n            // case KEY_RIGHT:{\n            //     highlight=(highlight == sideMenu.size()-1)? 0: highlight+1;\n            //     break;\n            // }\n            case KEY_ENTER:\n            case '\\n':{\n\n                if(!type.empty()){\n\n                    text.push_back(\"You: \"+type);\n                    //chat.push_back(\"You: \"+type);\n                    drawChat(mainInner, text);\n\n                }\n\n                type.clear();\n\n                wclrtoeol(bottomInner);\n\n                mvwprintw(bottomInner,1,1,\"Type > \");\n\n                wrefresh(bottomInner);\n\n                break;\n            }\n            case KEY_BACKSPACE:\n            case 127:\n            case '\\b': {\n                if(!type.empty()){\n                    type.pop_back();\n                }\n\n                wclrtoeol(bottomInner);\n                wmove(bottomInner,1,2);\n\n                mvwprintw(bottomInner,1,1,\"Type > %s\", type.c_str());\n                wrefresh(bottomInner);\n\n                break;\n            }\n\n        }\n        if(typingInput >=32 && typingInput <= 126){\n\n            //cast everything to char to stop display arrow up and down input\n            type+=static_cast<char>(typingInput);\n\n            wrefresh(bottomInner);\n\n            wclrtoeol(bottomInner);\n\n            wmove(bottomInner,1,1);\n\n            mvwprintw(bottomInner,1,1,\"Type > %s\",type.c_str());\n\n            wrefresh(bottomInner);\n\n\n        }\n    }\n\n    endwin();\n\n    return 0;\n\n}\n\nvoid drawLeft(WINDOW* leftInner, vector<string>& topicList , int highlight){\n\n\n    int length = topicList.size();\n\n    for(int i=0; i<length ; ++i){\n\n        if(i == highlight){\n            //start_color();\n            attron(A_REVERSE);\n                mvwprintw(leftInner, (i+3) ,1,\"> %s\",topicList[i].c_str());\n            attroff(A_REVERSE);\n\n        }else{\n            mvwprintw(leftInner, (i+3) ,1,topicList[i].c_str());\n        }\n\n    }\n\n    wrefresh(leftInner);\n\n}\n\nvoid drawChat(WINDOW* mainInner,vector<string>& text){\n\n    werase(mainInner);\n\n\n    int numMessages = text.size();\n\n    int chatHeight,chatWidth;\n\n    getmaxyx(mainInner,chatHeight,chatWidth);\n\n    //the function max use a floor of zero, and ruturns where we shoudl start inside the\n    //vector pending on screen size\n    int displayStart= max(0, static_cast<int>(text.size()) - chatHeight);\n\n    int rowTotal=0;\n    for(int i=displayStart; i< numMessages; i++){\n        mvwprintw(mainInner,rowTotal++,1,text[i].c_str());\n    }\n\n    wrefresh(mainInner);\n\n}\n\n","version":1,"path":"game.cpp","snapshot":true,"doc":5,"seq":9,"ms":42319,"op":"snap"}
