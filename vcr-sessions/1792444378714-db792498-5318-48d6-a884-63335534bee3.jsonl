{"text":"#include \"SpreadSheetCell.cpp\"\n#include <optional>\n#include <string>\n#include <string_view>\n\nusing namespace std;\n\n\n\nclass DoubleSpreadsheet : public SpreadSheetCell\n{\n    private:\n\n    optional<double> data;\n\n    public:\n     DoubleSpreadsheet( ){\n        data = 0;\n    }\n\n    DoubleSpreadsheet(string_view value){\n\n        data = stringToDouble(value);\n    }\n\n    void set(std::string_view value) override{\n        data = stringToDouble(value);\n    }\n\n    std::string getString() const override{\n\n        return doubleToString(data.value_or(0.0));\n    }\n    string doubleToString(double value){\n\n       return to_string(value);\n    }\n    double stringToDouble(std::string_view value){\n        data = stod(string(value));\n    }\n\n};\n","version":1,"path":"exercises/module_04/doubleSpreadsheet.cpp","snapshot":true,"doc":3,"seq":4,"ms":73382,"op":"snap"}
