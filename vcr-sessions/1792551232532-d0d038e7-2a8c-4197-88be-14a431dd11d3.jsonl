{"text":"#include \"SpreadSheetCell.h\"\n#include <optional>\n#include <format>\n#include <string>\n#include <string_view>\n\nusing namespace std;\n\n\nclass DoubleSpreadsheet : public SpreadSheetCell\n{\n    private:\n\n    optional<double> data;\n\n    public:\n\n\n    void set(double value){\n\n        data = value;\n    }\n\n    void set(std::string_view value) override{\n        data = stringToDouble(value);\n    }\n\n    std::string getString() const override{\n\n        return doubleToString(data.value_or(nullopt));\n    }\n    string doubleToString(double value)const\n    {\n\n       return to_string(value);\n    }\n    double stringToDouble(string_view value) const\n    {\n        optional<string_view> val =value ;\n\n        if(!val.has_value())\n            return 0;\n\n\n        return stod(string( val.value() ));\n    }\n\n};\n","version":1,"path":"assignments/assignment_02/DoubleSpreadsheet.h","snapshot":true,"doc":3,"seq":11,"ms":18042,"op":"snap"}
