{"text":"{\n    \"version\": \"2.0.0\",\n    \"tasks\": [\n        {\n            \"label\": \"Compile active C++23 file\",\n            \"type\": \"process\",\n            \"command\": \"g++-15\",\n            \"args\": [\n                \"-std=c++23\",\n                \"-g\",\n                \"${file}\",\n                \"-o\",\n                \"${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}.exe\"\n            ],\n            \"windows\": {\n                \"command\": \"g++\",\n                \"args\": [\n                    \"-std=c++23\",\n                    \"-g\",\n                    \"${file}\",\n                    \"-o\",\n                    \"${workspaceFolder}/.vscode/build/${fileBasenameNoExtension}.exe\",\n                    \"-lstdc++exp\"\n                ]\n            },\n            \"linux\": {\n                \"command\": \"g++-15\"\n            },\n            \"osx\": {\n                \"command\": \"g++-15\"\n            },\n            \"problemMatcher\": \"$gcc\",\n            \"group\": {\n                \"kind\": \"build\",\n                \"isDefault\": false\n            },\n            \"presentation\": {\n                \"reveal\": \"always\",\n                \"panel\": \"shared\",\n                \"clear\": true\n            },\n            \"detail\": \"Compile the active source file as a standalone C++23 program.\"\n        },\n        {\n            \"label\": \"Compile active C++23 folder\",\n            \"type\": \"process\",\n            \"command\": \"sh\",\n            \"args\": [\n                \"-c\",\n                \"set -eu\\nset -- \\\"$CPP_SOURCE_DIR\\\"/*.cpp\\nif [ ! -f \\\"$1\\\" ]; then\\n  echo \\\"No .cpp files found in the active folder.\\\" >&2\\n  exit 1\\nfi\\nmkdir -p \\\"$CPP_BUILD_DIR\\\"\\n\\\"$CPP_COMPILER\\\" -std=c++23 -g \\\"$@\\\" -o \\\"$CPP_BUILD_DIR/program.exe\\\"\"\n            ],\n            \"options\": {\n                \"cwd\": \"${fileDirname}\",\n                \"env\": {\n                    \"CPP_SOURCE_DIR\": \"${fileDirname}\",\n                    \"CPP_BUILD_DIR\": \"${workspaceFolder}/.vscode/build\",\n                    \"CPP_COMPILER\": \"g++-15\"\n                }\n            },\n            \"windows\": {\n                \"command\": \"powershell.exe\",\n                \"args\": [\n                    \"-NoProfile\",\n                    \"-NonInteractive\",\n                    \"-Command\",\n                    \"$ErrorActionPreference = 'Stop'; $sources = @(Get-ChildItem -LiteralPath $env:CPP_SOURCE_DIR -File -Filter '*.cpp' | Sort-Object Name); if ($sources.Count -eq 0) { throw 'No .cpp files found in the active folder.' }; New-Item -ItemType Directory -Force -Path $env:CPP_BUILD_DIR | Out-Null; $output = Join-Path $env:CPP_BUILD_DIR 'program.exe'; $sourcePaths = @($sources | ForEach-Object { $_.FullName }); & $env:CPP_COMPILER '-std=c++23' '-g' @sourcePaths '-o' $output '-lstdc++exp'; exit $LASTEXITCODE\"\n                ],\n                \"options\": {\n                    \"cwd\": \"${fileDirname}\",\n                    \"env\": {\n                        \"CPP_SOURCE_DIR\": \"${fileDirname}\",\n                        \"CPP_BUILD_DIR\": \"${workspaceFolder}/.vscode/build\",\n                        \"CPP_COMPILER\": \"g++\"\n                    }\n                }\n            },\n            \"linux\": {\n                \"options\": {\n                    \"cwd\": \"${fileDirname}\",\n                    \"env\": {\n                        \"CPP_SOURCE_DIR\": \"${fileDirname}\",\n                        \"CPP_BUILD_DIR\": \"${workspaceFolder}/.vscode/build\",\n                        \"CPP_COMPILER\": \"g++-15\"\n                    }\n                }\n            },\n            \"osx\": {\n                \"options\": {\n                    \"cwd\": \"${fileDirname}\",\n                    \"env\": {\n                        \"CPP_SOURCE_DIR\": \"${fileDirname}\",\n                        \"CPP_BUILD_DIR\": \"${workspaceFolder}/.vscode/build\",\n                        \"CPP_COMPILER\": \"g++-15\"\n                    }\n                }\n            },\n            \"problemMatcher\": \"$gcc\",\n            \"group\": \"build\",\n            \"presentation\": {\n                \"reveal\": \"always\",\n                \"panel\": \"shared\",\n                \"clear\": true\n            },\n            \"detail\": \"Compile every .cpp file in the active source file's folder as one C++23 program.\"\n        },\n        {\n            \"type\": \"cppbuild\",\n            \"label\": \"C/C++: g++ build active file\",\n            \"command\": \"/usr/bin/g++\",\n            \"args\": [\n                \"-fdiagnostics-color=always\",\n                \"-g\",\n                \"${file}\",\n                \"-o\",\n                \"${fileDirname}/${fileBasenameNoExtension}\"\n            ],\n            \"options\": {\n                \"cwd\": \"${fileDirname}\"\n            },\n            \"problemMatcher\": [\n                \"$gcc\"\n            ],\n            \"group\": {\n                \"kind\": \"build\",\n                \"isDefault\": true\n            },\n            \"detail\": \"Task generated by Debugger.\"\n        }\n    ]\n}","version":1,"path":".vscode/tasks.json","snapshot":true,"doc":6,"seq":90,"ms":873101,"op":"snap"}
